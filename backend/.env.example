# openrouter (default), grok (xAI), groq, or ollama
# LLM_PROVIDER=openrouter

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-calling model from https://openrouter.ai/models
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_VLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Groq: https://console.groq.com/keys - chat and image captions
# A second key is tried when the first one is rate-limited or rejected.
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VLM_MODEL=qwen/qwen3.8-27b

# xAI Grok: https://console.x.ai - also handles image captions
# XAI_API_KEY=
# GROK_MODEL=grok-4.7

# Local fallback (chat only; image captions still need a hosted key)
# OLLAMA_MODEL=llama3.2

# Supabase JWT secret (Project Settings → API). When set, /chat and /upload
# require Authorization: Bearer <access_token> and conversations are keyed by user id.
# SUPABASE_JWT_SECRET=
